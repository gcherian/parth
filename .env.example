# ── Required ──────────────────────────────────────────────────────────────────
# Postgres connection string (Fly.io: set via `fly secrets set DATABASE_URL=...`)
DATABASE_URL=postgresql://parth:parth_dev@localhost:5432/parth

# Anthropic API key — required in cloud mode (TUTOR_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM backend ───────────────────────────────────────────────────────────────
# "auto" → uses Anthropic if ANTHROPIC_API_KEY is set, else Ollama
# "anthropic" → cloud / pilot mode (no local GPU needed)
# "ollama" → local dev mode
TUTOR_BACKEND=auto

# Claude model for tutor responses and math verification
TUTOR_MODEL=claude-haiku-4-5-20251001

# ── Krishna Oracle ────────────────────────────────────────────────────────────
KRISHNA_MODEL=claude-haiku-4-5-20251001
KRISHNA_INTERVAL=10

# ── Ollama (local dev only — ignored when TUTOR_BACKEND=anthropic) ────────────
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=gemma3:12b
FAST_MODEL=llama3.2:latest

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
RATE_LIMIT=20

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to ChromaDB and other persistent data. In Docker/Fly.io this is a volume.
DATA_DIR=/data
